{
    "name": "examples-svelte",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "node ../shared/scripts/generate.ts svelte",
        "dev": "pnpm run generate && vite",
        "build": "pnpm run generate && vite build",
        "typecheck": "pnpm run generate && svelte-check --tsconfig tsconfig.json --fail-on-warnings",
        "e2e": "playwright test",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/flow-svelte": "workspace:*",
        "@lucide/svelte": "1.70.0",
        "clsx": "2.1.1",
        "svelte": "5.57.3",
        "tailwind-merge": "3.7.0",
        "tailwind-variants": "3.3.1"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "24.13.6",
        "examples-shared": "workspace:*",
        "svelte-check": "4.7.8",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "6.0.3",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
