{
    // TypeScript 6.0.3, pinned in this app only: svelte-check (the component type checker) takes
    // TypeScript 5 or 6, as packages/svelte. The packages it imports (from their sources) compile
    // with it too.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["@fragiola/source"],
        "types": ["node", "vite/client", "svelte"],
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.svelte",
        "tests",
        "*.config.ts",
        "*.config.js",
        "vite.shared.ts"
    ]
}
