{
    "name": "@fragiola/flow",
    "version": "0.0.0",
    "description": "Headless node-based editors and diagrams core: the flow document, a typed model with commands, and the engine that binds a flow to the DOM.",
    "keywords": [
        "flow",
        "node-editor",
        "diagram",
        "graph",
        "headless"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/flow.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/flow",
    "bugs": {
        "url": "https://github.com/fragiola/flow/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "24.13.6",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vitest": "5.0.2"
    }
}
