{
    "name": "@fragiola/flow-svelte",
    "version": "0.0.0",
    "description": "Composable, unstyled Svelte 5 primitives for @fragiola/flow: node-based editors and diagrams (nodes, edges, handles, connections, a pannable and zoomable viewport) styled entirely by you.",
    "keywords": [
        "svelte",
        "flow",
        "node-editor",
        "diagram",
        "graph",
        "headless"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/flow.git",
        "directory": "packages/svelte"
    },
    "homepage": "https://fragiola.com/flow",
    "bugs": {
        "url": "https://github.com/fragiola/flow/issues"
    },
    "sideEffects": false,
    "svelte": "./dist/index.js",
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/selection/index.d.ts",
            "svelte": "./dist/selection/index.js",
            "default": "./dist/selection/index.js"
        },
        "./subflows": {
            "@fragiola/source": "./src/subflows/index.ts",
            "types": "./dist/subflows/index.d.ts",
            "svelte": "./dist/subflows/index.js",
            "default": "./dist/subflows/index.js"
        },
        "./drag": {
            "@fragiola/source": "./src/drag/index.ts",
            "types": "./dist/drag/index.d.ts",
            "svelte": "./dist/drag/index.js",
            "default": "./dist/drag/index.js"
        },
        "./resize": {
            "@fragiola/source": "./src/resize/index.ts",
            "types": "./dist/resize/index.d.ts",
            "svelte": "./dist/resize/index.js",
            "default": "./dist/resize/index.js"
        },
        "./connection": {
            "@fragiola/source": "./src/connection/index.ts",
            "types": "./dist/connection/index.d.ts",
            "svelte": "./dist/connection/index.js",
            "default": "./dist/connection/index.js"
        },
        "./reconnection": {
            "@fragiola/source": "./src/reconnection/index.ts",
            "types": "./dist/reconnection/index.d.ts",
            "svelte": "./dist/reconnection/index.js",
            "default": "./dist/reconnection/index.js"
        },
        "./keyboard": {
            "@fragiola/source": "./src/keyboard/index.ts",
            "types": "./dist/keyboard/index.d.ts",
            "svelte": "./dist/keyboard/index.js",
            "default": "./dist/keyboard/index.js"
        },
        "./minimap": {
            "@fragiola/source": "./src/minimap/index.ts",
            "types": "./dist/minimap/index.d.ts",
            "svelte": "./dist/minimap/index.js",
            "default": "./dist/minimap/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "svelte": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./selection": {
                "types": "./dist/selection/index.d.ts",
                "svelte": "./dist/selection/index.js",
                "default": "./dist/selection/index.js"
            },
            "./subflows": {
                "types": "./dist/subflows/index.d.ts",
                "svelte": "./dist/subflows/index.js",
                "default": "./dist/subflows/index.js"
            },
            "./drag": {
                "types": "./dist/drag/index.d.ts",
                "svelte": "./dist/drag/index.js",
                "default": "./dist/drag/index.js"
            },
            "./resize": {
                "types": "./dist/resize/index.d.ts",
                "svelte": "./dist/resize/index.js",
                "default": "./dist/resize/index.js"
            },
            "./connection": {
                "types": "./dist/connection/index.d.ts",
                "svelte": "./dist/connection/index.js",
                "default": "./dist/connection/index.js"
            },
            "./reconnection": {
                "types": "./dist/reconnection/index.d.ts",
                "svelte": "./dist/reconnection/index.js",
                "default": "./dist/reconnection/index.js"
            },
            "./keyboard": {
                "types": "./dist/keyboard/index.d.ts",
                "svelte": "./dist/keyboard/index.js",
                "default": "./dist/keyboard/index.js"
            },
            "./minimap": {
                "types": "./dist/minimap/index.d.ts",
                "svelte": "./dist/minimap/index.js",
                "default": "./dist/minimap/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "svelte-package --input src --output dist --tsconfig tsconfig.build.json",
        "typecheck": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/flow": "workspace:*"
    },
    "peerDependencies": {
        "svelte": "^5.29.0"
    },
    "devDependencies": {
        "@sveltejs/package": "3.0.2",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "jsdom": "30.1.1",
        "svelte": "5.57.3",
        "svelte-check": "4.7.8",
        "typescript": "6.0.3",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
