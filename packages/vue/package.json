{
    "name": "@fragiola/flow-vue",
    "version": "0.0.0",
    "description": "Composable, unstyled Vue primitives for @fragiola/flow: node-based editors and diagrams (nodes, edges, handles, connections, a pannable and zoomable viewport) styled entirely by you.",
    "keywords": [
        "vue",
        "flow",
        "node-editor",
        "diagram",
        "graph",
        "headless"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/flow.git",
        "directory": "packages/vue"
    },
    "homepage": "https://fragiola.com/flow",
    "bugs": {
        "url": "https://github.com/fragiola/flow/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/selection.d.ts",
            "import": "./dist/selection.js",
            "default": "./dist/selection.js"
        },
        "./subflows": {
            "@fragiola/source": "./src/subflows/index.ts",
            "types": "./dist/subflows.d.ts",
            "import": "./dist/subflows.js",
            "default": "./dist/subflows.js"
        },
        "./drag": {
            "@fragiola/source": "./src/drag/index.ts",
            "types": "./dist/drag.d.ts",
            "import": "./dist/drag.js",
            "default": "./dist/drag.js"
        },
        "./resize": {
            "@fragiola/source": "./src/resize/index.ts",
            "types": "./dist/resize.d.ts",
            "import": "./dist/resize.js",
            "default": "./dist/resize.js"
        },
        "./connection": {
            "@fragiola/source": "./src/connection/index.ts",
            "types": "./dist/connection.d.ts",
            "import": "./dist/connection.js",
            "default": "./dist/connection.js"
        },
        "./reconnection": {
            "@fragiola/source": "./src/reconnection/index.ts",
            "types": "./dist/reconnection.d.ts",
            "import": "./dist/reconnection.js",
            "default": "./dist/reconnection.js"
        },
        "./keyboard": {
            "@fragiola/source": "./src/keyboard/index.ts",
            "types": "./dist/keyboard.d.ts",
            "import": "./dist/keyboard.js",
            "default": "./dist/keyboard.js"
        },
        "./minimap": {
            "@fragiola/source": "./src/minimap/index.ts",
            "types": "./dist/minimap.d.ts",
            "import": "./dist/minimap.js",
            "default": "./dist/minimap.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./selection": {
                "types": "./dist/selection.d.ts",
                "import": "./dist/selection.js",
                "default": "./dist/selection.js"
            },
            "./subflows": {
                "types": "./dist/subflows.d.ts",
                "import": "./dist/subflows.js",
                "default": "./dist/subflows.js"
            },
            "./drag": {
                "types": "./dist/drag.d.ts",
                "import": "./dist/drag.js",
                "default": "./dist/drag.js"
            },
            "./resize": {
                "types": "./dist/resize.d.ts",
                "import": "./dist/resize.js",
                "default": "./dist/resize.js"
            },
            "./connection": {
                "types": "./dist/connection.d.ts",
                "import": "./dist/connection.js",
                "default": "./dist/connection.js"
            },
            "./reconnection": {
                "types": "./dist/reconnection.d.ts",
                "import": "./dist/reconnection.js",
                "default": "./dist/reconnection.js"
            },
            "./keyboard": {
                "types": "./dist/keyboard.d.ts",
                "import": "./dist/keyboard.js",
                "default": "./dist/keyboard.js"
            },
            "./minimap": {
                "types": "./dist/minimap.d.ts",
                "import": "./dist/minimap.js",
                "default": "./dist/minimap.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/flow": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "7.0.1",
        "@vue/test-utils": "2.5.1",
        "jsdom": "30.1.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2",
        "vue": "3.5.45"
    }
}
