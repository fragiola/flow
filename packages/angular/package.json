{
    "name": "@fragiola/flow-angular",
    "version": "0.0.0",
    "description": "Composable, unstyled Angular directives for @fragiola/flow: node-based editors and diagrams (nodes, edges, handles, connections, a pannable and zoomable viewport) styled entirely by you.",
    "keywords": [
        "angular",
        "flow",
        "node-editor",
        "diagram",
        "graph",
        "headless"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/flow.git",
        "directory": "packages/angular"
    },
    "homepage": "https://fragiola.com/flow",
    "bugs": {
        "url": "https://github.com/fragiola/flow/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/public-api.ts",
            "types": "./dist/types/fragiola-flow-angular.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular.mjs"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/types/fragiola-flow-angular-selection.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-selection.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-selection.mjs"
        },
        "./subflows": {
            "@fragiola/source": "./src/subflows/index.ts",
            "types": "./dist/types/fragiola-flow-angular-subflows.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-subflows.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-subflows.mjs"
        },
        "./drag": {
            "@fragiola/source": "./src/drag/index.ts",
            "types": "./dist/types/fragiola-flow-angular-drag.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-drag.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-drag.mjs"
        },
        "./resize": {
            "@fragiola/source": "./src/resize/index.ts",
            "types": "./dist/types/fragiola-flow-angular-resize.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-resize.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-resize.mjs"
        },
        "./connection": {
            "@fragiola/source": "./src/connection/index.ts",
            "types": "./dist/types/fragiola-flow-angular-connection.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-connection.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-connection.mjs"
        },
        "./reconnection": {
            "@fragiola/source": "./src/reconnection/index.ts",
            "types": "./dist/types/fragiola-flow-angular-reconnection.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-reconnection.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-reconnection.mjs"
        },
        "./keyboard": {
            "@fragiola/source": "./src/keyboard/index.ts",
            "types": "./dist/types/fragiola-flow-angular-keyboard.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-keyboard.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-keyboard.mjs"
        },
        "./minimap": {
            "@fragiola/source": "./src/minimap/index.ts",
            "types": "./dist/types/fragiola-flow-angular-minimap.d.ts",
            "import": "./dist/fesm2022/fragiola-flow-angular-minimap.mjs",
            "default": "./dist/fesm2022/fragiola-flow-angular-minimap.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/types/fragiola-flow-angular.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular.mjs"
            },
            "./selection": {
                "types": "./dist/types/fragiola-flow-angular-selection.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-selection.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-selection.mjs"
            },
            "./subflows": {
                "types": "./dist/types/fragiola-flow-angular-subflows.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-subflows.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-subflows.mjs"
            },
            "./drag": {
                "types": "./dist/types/fragiola-flow-angular-drag.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-drag.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-drag.mjs"
            },
            "./resize": {
                "types": "./dist/types/fragiola-flow-angular-resize.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-resize.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-resize.mjs"
            },
            "./connection": {
                "types": "./dist/types/fragiola-flow-angular-connection.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-connection.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-connection.mjs"
            },
            "./reconnection": {
                "types": "./dist/types/fragiola-flow-angular-reconnection.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-reconnection.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-reconnection.mjs"
            },
            "./keyboard": {
                "types": "./dist/types/fragiola-flow-angular-keyboard.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-keyboard.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-keyboard.mjs"
            },
            "./minimap": {
                "types": "./dist/types/fragiola-flow-angular-minimap.d.ts",
                "import": "./dist/fesm2022/fragiola-flow-angular-minimap.mjs",
                "default": "./dist/fesm2022/fragiola-flow-angular-minimap.mjs"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node scripts/check-dist.ts",
        "typecheck": "ngc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/flow": "workspace:*"
    },
    "peerDependencies": {
        "@angular/core": "^22.0.0"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "2.9.6",
        "@analogjs/vitest-angular": "2.9.6",
        "@angular/build": "22.2.6",
        "@angular/common": "22.2.5",
        "@angular/compiler": "22.2.5",
        "@angular/compiler-cli": "22.2.5",
        "@angular/core": "22.2.5",
        "@angular/platform-browser": "22.2.5",
        "@testing-library/jest-dom": "7.0.1",
        "jsdom": "30.1.1",
        "ng-packagr": "22.2.6",
        "rxjs": "7.8.2",
        "typescript": "6.0.3",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
